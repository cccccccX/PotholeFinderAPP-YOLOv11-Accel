<?xml version="1.0" encoding="utf-8"?>
<!-- res/layout/activity_main.xml -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- 第一行：切换摄像头按钮 -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">

        <Button
            android:id="@+id/buttonSwitchCamera"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="切换摄像头" />
    </LinearLayout>

    <!-- 第二行：模型与 CPU/GPU 选择 -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">

        <Spinner
            android:id="@+id/spinnerModel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawSelectorOnTop="true"
            android:entries="@array/model_array" />

        <Spinner
            android:id="@+id/spinnerCPUGPU"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawSelectorOnTop="true"
            android:entries="@array/cpugpu_array" />
    </LinearLayout>

    <!-- 中间部分：SurfaceView 撑满中间 -->
    <SurfaceView
        android:id="@+id/cameraview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- 下方部分：文本显示区域及按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- 两个 TextView：加速度和角速度 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/textView_acceleration"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="加速度数据："
                android:textSize="18sp" />

            <TextView
                android:id="@+id/textView_gyroscope"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="角速度数据："
                android:textSize="18sp" />
        </LinearLayout>

        <!-- 地理位置和当前时间 -->
        <TextView
            android:id="@+id/textView_location"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="正在获取地理位置..."
            android:textSize="18sp"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/textView_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="当前时间："
            android:textSize="18sp"
            android:layout_marginTop="8dp" />

        <!-- 加速度检测计数 -->
        <TextView
            android:id="@+id/tvDetected"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="加速度检测：0"
            android:textSize="18sp"
            android:layout_marginTop="8dp" />

        <!-- 将“开始采集”按钮与“标记坑洼时间戳”按钮放入同一行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp"
            android:gravity="center_horizontal">

            <Button
                android:id="@+id/button_toggle_collection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="开始采集" />

            <Button
                android:id="@+id/button_mark_timestamp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="标记坑洼时间戳"
                android:layout_marginLeft="16dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
